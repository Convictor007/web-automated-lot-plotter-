# ── Internal API server (npm run dev:api) — not sent to the browser ──

API_PORT=5175



# Google Gemini — required for AI scan (Tesseract OCR text → Gemini JSON)

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

GEMINI_MAX_RETRIES=4

# Optional comma-separated fallbacks when primary model is busy (defaults built-in)

# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash



# ── Security (server) ──

# Comma-separated browser origins (required for non-Vercel production).
# On Vercel, deployment URLs are auto-allowed; add custom domains if needed:

# CORS_ORIGINS=https://your-custom-domain.com

# Behind nginx/IIS: TRUST_PROXY=true

# TRUST_PROXY=false

# RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX=120

# OCR_RATE_LIMIT_MAX=20

# REQUEST_TIMEOUT_MS=120000



# ── Vite client ──

VITE_GOOGLE_MAPS_API_KEY=



# VITE_API_BASE_URL=

